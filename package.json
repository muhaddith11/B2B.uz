{
  "name": "savdo-platforma",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project mobile",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:review": "node --env-file-if-exists=.env --import tsx prisma/review.ts",
    "keys:reencrypt": "node --env-file-if-exists=.env --import tsx scripts/reencrypt-keys.ts",
    "files:to-blob": "node --env-file-if-exists=.env --import tsx scripts/files-to-blob.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "vercel-build": "node --import tsx scripts/vercel-build.ts",
    "lint": "eslint . --max-warnings=0",
    "test:int": "vitest run --project integration",
    "test:coverage": "vitest run --project unit --project integration --coverage"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.8.1",
    "exceljs": "^4.4.0",
    "next": "^15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.30"
    },
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "deepmerge-ts": "^8.0.2"
  }
}
