    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_API_URL": "https://b2b-uz.vercel.app" }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6824516767",
