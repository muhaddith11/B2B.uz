{
  "expo": {
    "name": "Captar",
    "slug": "captar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "captar",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "uz.captar.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#23205C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "uz.captar.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#23205C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "To'lov cheki va tovar rasmini yuklash uchun galereyaga ruxsat bering",
          "cameraPermission": "To'lov cheki va tovar rasmini olish uchun kameraga ruxsat bering",
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      [
        "expo-localization",
        {
          "supportedLocales": [
            "uz",
            "ru"
          ]
        }
      ]
    ],
    "locales": {
      "uz": "./locales/uz.json",
      "ru": "./locales/ru.json"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cb941320-1003-46aa-b28f-67730f117efc"
      }
    },
    "owner": "muhaddith"
  }
}
