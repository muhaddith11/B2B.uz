DATABASE_URL_UNPOOLED="postgresql://postgres:PAROL@localhost:5432/savdo?schema=public"
# Integratsiya testlari (npm run test:int) uchun ALOHIDA baza. Nomi _test bilan tugashi shart: testlar boshqa bazada ishlamaydi
TEST_DATABASE_URL="postgresql://postgres:PAROL@localhost:5432/savdo_test?schema=public"
# Kod so'rash: butun platforma bo'yicha soatiga nechta SMS (hujumdan himoya). Bo'sh bo'lsa 500
