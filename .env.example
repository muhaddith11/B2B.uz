# 1 = sinov rejimi: SMS yuborilmaydi (kod ilovada ko'rinadi), panel va admin sahifasiga demo kirish. Faqat lokal!
DEV_AUTH=1
# Serverning tashqi manzili: Payme/Click qaytish sahifasi va kabinetga kiritiladigan manzillar uchun
PUBLIC_URL="http://localhost:3000"
# Platforma adminlari (web /admin): distribyutor va tovar egalarini tasdiqlaydi. Vergul bilan
