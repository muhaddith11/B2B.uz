ESKIZ_PASSWORD=""
ESKIZ_FROM="4546"

# 1 = demo server: SMS xizmati yo'q bo'lsa kirish kodi ilovada ko'rinadi. Faqat demo ma'lumotlar bilan! Eskiz ulangach o'chiring
DEMO_OTP=""
# Vercel Blob (cheklar va tovar rasmlari uchun yopiq ombor). Vercel loyihasiga Blob ombori ulanganda avtomatik qo'shiladi
