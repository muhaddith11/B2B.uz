DATABASE_URL="postgresql://postgres:PAROL@localhost:5432/savdo?schema=public"
# Migratsiyalar uchun to'g'ridan-to'g'ri ulanish. Lokal: DATABASE_URL bilan bir xil. Supabase: session pooler (5432) manzili
DIRECT_URL="postgresql://postgres:PAROL@localhost:5432/savdo?schema=public"
# Kamida 32 belgi, tasodifiy. To'lov tizimi kalitlari ham shu bilan shifrlanadi: almashtirsangiz, Payme/Click kalitlarini qayta kiriting
SESSION_SECRET=""
# 1 = sinov rejimi: SMS yuborilmaydi (kod ilovada ko'rinadi), panel va admin sahifasiga demo kirish. Faqat lokal!
DEV_AUTH=1
# Serverning tashqi manzili: Payme/Click qaytish sahifasi va kabinetga kiritiladigan manzillar uchun
PUBLIC_URL="http://localhost:3000"
# Platforma adminlari (web /admin): distribyutor va tovar egalarini tasdiqlaydi. Vergul bilan
PLATFORM_ADMIN_PHONES="+998901234567"

# Eskiz.uz SMS (ilovaga kirish kodi). Bo'sh bo'lsa, kod server logiga chiqadi
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""
ESKIZ_FROM="4546"

# 1 = demo server: SMS xizmati yo'q bo'lsa kirish kodi ilovada ko'rinadi. Faqat demo ma'lumotlar bilan! Eskiz ulangach o'chiring
DEMO_OTP=""
# Vercel Blob (cheklar uchun yopiq ombor). Vercel loyihasiga Blob ombori ulanganda avtomatik qo'shiladi
BLOB_READ_WRITE_TOKEN=""
# 1 = Payme sinov kassasi (checkout.test.paycom.uz)
PAYME_TEST=""
# Expo push xizmati uchun (ixtiyoriy, "Enhanced security" yoqilgan bo'lsa kerak)
EXPO_ACCESS_TOKEN=""
# To'lov cheklari saqlanadigan papka (bo'sh bo'lsa: ./uploads)
UPLOAD_DIR=""

# Telegram Mini App (ixtiyoriy): @BotFather bergan bot tokeni
TELEGRAM_BOT_TOKEN=""
