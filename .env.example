PLATFORM_CLICK_MERCHANT_ID=""
PLATFORM_CLICK_SECRET_KEY=""
# Kamida 32 belgi, tasodifiy. To'lov tizimi kalitlari ham shu bilan shifrlanadi: almashtirsangiz, Payme/Click kalitlarini qayta kiriting
