SUPPORT_PHONE=""

# SMS (ilovaga kirish kodi): TextUP (textup.uz) kabinetining login va paroli. Bo'sh bo'lsa, kod server logiga chiqadi
TEXTUP_EMAIL=""
TEXTUP_PASSWORD=""
# Ixtiyoriy: alfa-nom (jo'natuvchi nomi) ID'si va tasdiqlangan shablon ID'si. Alfa-nomsiz qisqa raqamdan yuboriladi
TEXTUP_NICKNAME_ID=""
TEXTUP_TEMPLATE_ID=""
# Ixtiyoriy: SMS matni ({code} o'rniga kod). TextUP kabinetida aynan shu matn shablon sifatida tasdiqlangan bo'lishi kerak
OTP_SMS_TEXT=""
# Ixtiyoriy: hisobni o'chirish kodi uchun alohida matn (TextUP'da alohida shablon tasdiqlangach). Bo'sh bo'lsa umumiy matn
OTP_DELETE_SMS_TEXT=""
# Baza tarifining hajm chegarasi, MB: /admin sahifasi 80% dan oshganda ogohlantiradi. Bo'sh bo'lsa 512 (bepul Neon)
