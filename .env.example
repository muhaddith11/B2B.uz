# Obuna to'lovlari: platformaning O'Z Payme va Click kassasi (distribyutorlarning kassasi emas). Bo'sh bo'lsa /obuna sahifasida to'lov tugmasi yo'q
# Payme kabinetiga manzil: <PUBLIC_URL>/api/subscription/payme
PLATFORM_PAYME_MERCHANT_ID=""
PLATFORM_PAYME_KEY=""
# Click kabinetiga manzillar: <PUBLIC_URL>/api/subscription/click/prepare va .../complete
